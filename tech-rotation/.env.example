# Vorlage fuer lokale Zugangsdaten. Kopieren nach .env und ausfuellen:
#
#     cp .env.example .env
#     set -a && source .env && set +a
#
# .env selbst gehoert NICHT ins Repository -- die .gitignore haelt sie draussen.
# Fuer den GitHub-Workflow gehoeren dieselben Werte in die Repository-Secrets.

# --- Broker -----------------------------------------------------------------
# Nur noetig fuer execution.broker: alpaca. Der Paper-Broker braucht nichts.
# Schluessel gibt es unter app.alpaca.markets -> Paper Trading -> API Keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Live-Freigabe ----------------------------------------------------------
# Die dritte von drei Sicherungen. Nur setzen, wenn wirklich echtes Geld
# bewegt werden soll -- und dann auch nur zusammen mit execution.mode: live
# und execution.broker: alpaca in der config.yaml.
#
# TECHROT_ALLOW_LIVE=I_UNDERSTAND

# --- Optionale Datenquellen -------------------------------------------------
# Das Standard-Setup (yfinance) braucht keinen Schluessel.
